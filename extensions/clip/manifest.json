{
  "manifest_version": 3,
  "name": "Send to Kobo",
  "short_name": "Send to Kobo",
  "version": "1.0.0",
  "description": "Send a web page, a link or a selection to your Kobo as a clean article, through Cobalt on this computer.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["contextMenus", "activeTab", "scripting", "nativeMessaging", "notifications"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "send-to-kobo@cobalt.bandarlabs.github.io",
      "strict_min_version": "128.0"
    }
  }
}
