    {
      "kind": "Text",
      "x": 233,
      "y": 133,
      "width": 938,
      "height": 192,
      "centre": {
        "x": 702,
        "y": 229
      },
      "action": null,
      "lines": [
        "Use 1\u20139 once in each row, column and 3\u00d73 box. The",
        "shaded cross follows your selection; a bracketed",
        "number or small square marks your target. Given",
        "numbers cannot change."
      ]
    },
    {
      "kind": "Text",
      "x": 233,
      "y": 334,
      "width": 938,
      "height": 192,
      "centre": {
        "x": 702,
        "y": 430
      },
      "action": null,
      "lines": [
        "Tap Notes, then numbers to add or remove notes. A dot",
        "marks a square with notes; its selected numbers have",
        "outlined keys. Tap Digits to enter answers. Erase a filled",
        "square before adding notes."
      ]
    },
    {
      "kind": "Text",
      "x": 233,
      "y": 535,
      "width": 938,
      "height": 192,
      "centre": {
        "x": 702,
        "y": 631
      },
      "action": null,
      "lines": [
        "More offers erase, checking and reveal. Checking starts",
        "off. Turn it on to flag a wrong selected answer without",
        "rejecting your entry. Revealing a square asks first and",
        "counts as a hint."
      ]
    },
    {
      "kind": "Text",
      "x": 233,
      "y": 736,
      "width": 938,
      "height": 192,
      "centre": {
        "x": 702,
        "y": 832
      },
      "action": null,
      "lines": [
        "Your game saves after every edit. Undo restores the last",
        "64 moves, even after reopening. A full correct grid",
        "completes the puzzle. New puzzle replaces the current",
        "game and its history."
      ]
    },
    {
      "kind": "Text",
      "x": 233,
      "y": 937,
      "width": 938,
      "height": 96,
      "centre": {
        "x": 702,
        "y": 985
      },
      "action": null,
      "lines": [
        "Landscape shows the whole board with the digits",
        "beside it."
      ]
    },
    {
      "kind": "Text",
      "x": 233,
      "y": 1042,
      "width": 938,
      "height": 192,
      "centre": {
        "x": 702,
        "y": 1138
      },
      "action": null,
      "lines": [
        "There are 12 original puzzles per difficulty. Easy uses",
        "single candidates. Medium adds single locations in a",
        "row, column or box. Hard needs more advanced",
        "techniques."
      ]
    },
