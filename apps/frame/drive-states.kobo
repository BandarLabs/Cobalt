# Walk Home, full-frame Open, and the next photograph after a seeded push.
expect Frame
expect Photographs
wait-for Open
wait-idle
clean
shot home-photo
tap Open
wait-idle
expect-missing Open
clean
shot show
# Page-turn zone on the right of the unframed photograph.
tap-at 1000,720
wait-idle
expect-missing Open
clean
shot show-next
