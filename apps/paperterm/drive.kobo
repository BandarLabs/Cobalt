scenario offline
expect Terminal sessions
clean
shot welcome
tap-id preview
expect Preview
expect Nothing is running on your computer
clean
expect-state /activity#/effects/fetch 0
expect-state /activity#/effects/post 0
shot preview
tap-id welcome
tap-id setup
expect Pair once
clean
shot setup
expect-missing kobo trust set
tap-id trust
expect Reopen Cobalt once
clean
shot trust
tap-id start
expect Share a terminal
expect kobo stream terminal
expect-missing --interactive
clean
shot start
tap-id enter-address
expect Pair with your computer
clean
shot pairing
type bad address
tap-id kb.enter
expect Use a name or IP address
clean
shot address-error
tap-id kb.backspace
tap-id kb.backspace
tap-id kb.backspace
tap-id kb.backspace
tap-id kb.backspace
tap-id kb.backspace
tap-id kb.backspace
tap-id kb.backspace
tap-id kb.backspace
tap-id kb.backspace
tap-id kb.backspace
type laptop
tap-id kb.enter
expect Now the pairing code
clean
shot code
type xyz
tap-id kb.enter
expect Enter the six letters and numbers
clean
shot code-error
expect-state /activity#/effects/fetch 0
expect-state /activity#/effects/post 0
tap-id edit-address
expect laptop:9332
tap-id kb.enter
expect xyz
clean
shot code-preserved

# A pairing that has never connected says so, rather than that a connection
# was lost, and names the cause.
tap-id kb.backspace
tap-id kb.backspace
tap-id kb.backspace
type abc234
tap-id kb.enter
wait-for This Kobo is not on Wi-Fi.
expect Not connected
expect-missing Connection lost
clean
shot not-connected-yet
