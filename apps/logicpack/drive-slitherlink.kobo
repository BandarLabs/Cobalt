# Slitherlink from the first loop to Next puzzle, and the count that follows.
expect Logic Pack
expect One loop · 0 of 105 solved
tap Slitherlink
expect 0 of 9 solved
expect Four twos
# The grades are chips; each lists its own puzzles.
tap-id level-1
expect First bend
expect-missing Four twos
tap-id level-3
expect Puzzle 1
tap-id level-0
expect Four twos
tap-id next-puzzles
expect 2 of 2
expect-missing Four twos
tap-id previous-puzzles
tap Four twos
wait-for-id game-more
expect Starter · Four twos
expect Mark crosses
# Rules then Difficulty, two pages that each lead back to the board.
tap Rules
expect Draw one loop with no branches or crossings.
clean
shot slitherlink-rules
tap Difficulty
expect A 2 × 2 board with every clue shown.
clean
shot slitherlink-difficulty
tap-id previous-help
expect Draw one loop
tap Play
wait-for-id game-more
# A tap draws a line; in cross mode a tap marks where none goes.
tap-id edge-0
expect Horizontal 1,1 to 1,3: single
tap-id line-mode
expect Draw lines
tap-id edge-2
expect Horizontal 3,1 to 3,3: excluded
clean
shot slitherlink-cross
tap-id game-undo
expect Horizontal 3,1 to 3,3: blank
expect Draw lines
tap-id line-mode
expect Mark crosses
# A closed loop around the wrong squares names the rule it breaks.
tap-id edge-1
tap-id edge-2
tap-id edge-3
tap-id edge-6
tap-id edge-8
expect The line is closed, but a clue does not match
clean
shot slitherlink-broken-rule
tap-id game-undo
tap-id game-undo
tap-id game-undo
tap-id game-undo
tap-id game-undo
expect Horizontal 1,3 to 1,5: blank
expect Horizontal 1,1 to 1,3: single
# The loop round all four squares solves it.
tap-id edge-1
tap-id edge-4
tap-id edge-5
tap-id edge-6
tap-id edge-8
tap-id edge-9
tap-id edge-11
expect Solved.
expect Next puzzle
expect-missing Mark crosses
clean
shot slitherlink-solved
# The list and the home screen both count it.
tap-id game-more
tap Puzzles
expect 1 of 9 solved
expect 2 × 2 · Solved
tap-id 4294967295
expect One loop · 1 of 105 solved
# A solved puzzle stays solved after closing the app.
restart
wait-for Logic Pack
expect One loop · 1 of 105 solved
tap Slitherlink
tap Four twos
wait-for-id game-more
expect Solved.
tap Next puzzle
wait-for-id game-more
expect Starter · Puzzle 2
