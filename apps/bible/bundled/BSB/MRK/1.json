    "chapter":  {
                    "number":  1,
                    "content":  [
                                    {
                                        "type":  "heading",
                                        "text":  "The Mission of John the Baptist"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  1,
                                        "text":  "This is the beginning of the gospel of Jesus Christ, the Son of God.",
                                        "footnotes":  [
                                                          {
                                                              "noteId":  0,
                                                              "offset":  68,
                                                              "text":  "ECM, NE, BYZ, and TR; SBL and WH the beginning of the gospel of Jesus Christ.",
                                                              "caller":  "+"
                                                          }
                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  2,
                                        "text":  "As it is written in Isaiah the prophet:\nâBehold, I will send My messenger ahead of You,\nwho will prepare Your way.â",
                                        "footnotes":  [
                                                          {
                                                              "noteId":  1,
                                                              "offset":  39,
                                                              "text":  "BYZ and TR in the prophets:",
                                                              "caller":  "+"
                                                          },
                                                          {
                                                              "noteId":  2,
                                                              "offset":  115,
                                                              "text":  "Malachi 3:1",
                                                              "caller":  "+"
                                                          }
                                                      ],
                                        "poem":  [
                                                     {
                                                         "start":  40,
                                                         "end":  87,
                                                         "level":  1
                                                     },
                                                     {
                                                         "start":  88,
                                                         "end":  115,
                                                         "level":  2
                                                     }
                                                 ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  3,
                                        "text":  "âA voice of one calling in the wilderness,\nâPrepare the way for the Lord,\nmake straight paths for Him.ââ",
                                        "footnotes":  [
                                                          {
                                                              "noteId":  3,
                                                              "offset":  104,
                                                              "text":  "Isaiah 40:3 (see also LXX)",
                                                              "caller":  "+"
                                                          }
                                                      ],
                                        "poem":  [
                                                     {
                                                         "start":  0,
                                                         "end":  42,
                                                         "level":  1
                                                     },
                                                     {
                                                         "start":  43,
                                                         "end":  73,
                                                         "level":  2
                                                     },
                                                     {
                                                         "start":  74,
                                                         "end":  104,
                                                         "level":  2
                                                     }
                                                 ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  4,
                                        "text":  "John the Baptist appeared in the wilderness, preaching a baptism of repentance for the forgiveness of sins.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  5,
                                        "text":  "People went out to him from all of Jerusalem and the countryside of Judea. Confessing their sins, they were baptized by him in the Jordan River.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  6,
                                        "text":  "John was clothed in camelâs hair, with a leather belt around his waist. His food was locusts and wild honey.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  7,
                                        "text":  "And he proclaimed: âAfter me will come One more powerful than I, the straps of whose sandals I am not worthy to stoop down and untie.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  8,
                                        "text":  "I baptize you with water, but He will baptize you with the Holy Spirit. â",
                                        "footnotes":  [
                                                          {
                                                              "noteId":  4,
                                                              "offset":  25,
                                                              "text":  "Or in water",
                                                              "caller":  "+"
                                                          },
                                                          {
                                                              "noteId":  5,
                                                              "offset":  71,
                                                              "text":  "Or in the Holy Spirit",
                                                              "caller":  "+"
                                                          }
                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  9,
                                        "text":  "In those days Jesus came from Nazareth in Galilee and was baptized by John in the Jordan.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  10,
                                        "text":  "As soon as Jesus came up out of the water, He saw the heavens breaking open and the Spirit descending on Him like a dove.",
                                        "footnotes":  [
                                                          {
                                                              "noteId":  6,
                                                              "offset":  49,
                                                              "text":  "Or he saw; see John 1:32â33",
                                                              "caller":  "+"
                                                          }
                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  11,
                                        "text":  "And a voice came from heaven: âYou are My beloved Son; in You I am well pleased.â",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "heading",
                                        "text":  "The Temptation and Preaching of Jesus"
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  12,
                                        "text":  "At once the Spirit drove Jesus into the wilderness,",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  13,
                                        "text":  "and He was there for forty days, being tempted by Satan. He was with the wild animals, and the angels ministered to Him.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  14,
                                        "text":  "After the arrest of John, Jesus went into Galilee and proclaimed the gospel of God.",
                                        "footnotes":  [
                                                          {
                                                              "noteId":  7,
                                                              "offset":  83,
                                                              "text":  "BYZ and TR the gospel of the kingdom of God",
                                                              "caller":  "+"
                                                          }
                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  15,
                                        "text":  "âThe time is fulfilled,â He said, âand the kingdom of God is near. Repent and believe in the gospel!â",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "heading",
                                        "text":  "The First Disciples"
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  16,
                                        "text":  "As Jesus was walking beside the Sea of Galilee, He saw Simon and his brother Andrew. They were casting a net into the sea, for they were fishermen.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  17,
                                        "text":  "âCome, follow Me,â Jesus said, âand I will make you fishers of men.â",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  18,
                                        "text":  "And at once they left their nets and followed Him.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  19,
                                        "text":  "Going on a little farther, He saw James son of Zebedee and his brother John. They were in a boat, mending their nets.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  20,
                                        "text":  "Immediately Jesus called them, and they left their father Zebedee in the boat with the hired men and followed Him.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "heading",
                                        "text":  "Jesus Expels an Unclean Spirit"
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  21,
                                        "text":  "Then Jesus and His companions went to Capernaum, and right away Jesus entered the synagogue on the Sabbath and began to teach.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  22,
                                        "text":  "The people were astonished at His teaching, because He taught as one who had authority, and not as the scribes.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  23,
                                        "text":  "Suddenly a man with an unclean spirit cried out in the synagogue:",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  24,
                                        "text":  "âWhat do You want with us, Jesus of Nazareth? Have You come to destroy us? I know who You areâthe Holy One of God!â",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  25,
                                        "text":  "But Jesus rebuked the spirit. âBe silent!â He said. âCome out of him!â",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  26,
                                        "text":  "At this, the unclean spirit threw the man into convulsions and came out with a loud shriek.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  27,
                                        "text":  "All the people were amazed and began to ask one another, âWhat is this? A new teaching with authority! He commands even the unclean spirits, and they obey Him!â",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  28,
                                        "text":  "And the news about Jesus spread quickly through the whole region of Galilee.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "heading",
                                        "text":  "Jesus Heals at Peterâs House"
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  29,
                                        "text":  "As soon as Jesus and His companions had left the synagogue, they went with James and John to the home of Simon and Andrew.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  30,
                                        "text":  "Simonâs mother-in-law was sick in bed with a fever, and they promptly told Jesus about her.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  31,
                                        "text":  "So He went to her, took her by the hand, and helped her up. The fever left her, and she began to serve them.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  32,
                                        "text":  "That evening, after sunset, people brought to Jesus all the sick and demon-possessed,",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  33,
                                        "text":  "and the whole town gathered at the door.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  34,
                                        "text":  "And He healed many who were ill with various diseases and drove out many demons. But He would not allow the demons to speak, because they knew who He was.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "heading",
                                        "text":  "Jesus Prays and Preaches"
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  35,
                                        "text":  "Early in the morning, while it was still dark, Jesus got up and went out to a solitary place to pray.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  36,
                                        "text":  "Simon and his companions went to look for Him,",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  37,
                                        "text":  "and when they found Him, they said, âEveryone is looking for You!â",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  38,
                                        "text":  "But Jesus answered, âLet us go on to the neighboring towns so I can preach there as well, for that is why I have come.â",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  39,
                                        "text":  "So He went throughout Galilee, preaching in their synagogues and driving out demons.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "heading",
                                        "text":  "The Leperâs Prayer"
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  40,
                                        "text":  "Then a leper came to Jesus, begging on his knees: âIf You are willing, You can make me clean.â",
                                        "footnotes":  [
                                                          {
                                                              "noteId":  8,
                                                              "offset":  12,
                                                              "text":  "A leper was one afflicted with a skin disease. See Leviticus 13.",
                                                              "caller":  "+"
                                                          }
                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  41,
                                        "text":  "Moved with compassion, Jesus reached out His hand and touched the man. âI am willing,â He said. âBe clean!â",
                                        "footnotes":  [
                                                          {
                                                              "noteId":  9,
                                                              "offset":  22,
                                                              "text":  "SBL Moved with indignation",
                                                              "caller":  "+"
                                                          }
                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  42,
                                        "text":  "And immediately the leprosy left him, and the man was cleansed.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  43,
                                        "text":  "Jesus promptly sent him away with a stern warning:",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  44,
                                        "text":  "âSee that you donât tell anyone. But go, show yourself to the priest and present the offering Moses prescribed for your cleansing, as a testimony to them.â",
                                        "footnotes":  [
                                                          {
                                                              "noteId":  10,
                                                              "offset":  155,
                                                              "text":  "See Leviticus 14:1â32.",
                                                              "caller":  "+"
                                                          }
                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  45,
                                        "text":  "But the man went out and openly began to proclaim and spread the news.\nConsequently, Jesus could no longer enter a town in plain view, but He stayed out in solitary places. Yet people came to Him from every quarter.",
                                        "footnotes":  [

                                                      ]
                                    }
                                ],
                    "footnotes":  [

                                  ]
                },
    "fullChapterApiLink":  "/api/BSB/MRK/1.json"
}
