    "numberOfVerses":  43,
    "chapter":  {
                    "number":  5,
                    "content":  [
                                    {
                                        "type":  "heading",
                                        "text":  "The Demons and the Pigs"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  1,
                                        "text":  "On the other side of the sea, they arrived in the region of the Gerasenes.",
                                        "footnotes":  [
                                                          {
                                                              "noteId":  25,
                                                              "offset":  74,
                                                              "text":  "BYZ and TR Gadarenes; GOC Gergesenes",
                                                              "caller":  "+"
                                                          }
                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  2,
                                        "text":  "As soon as Jesus got out of the boat, He was met by a man with an unclean spirit, who was coming from the tombs.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  3,
                                        "text":  "This man had been living in the tombs and could no longer be restrained, even with chains.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  4,
                                        "text":  "Though he was often bound with chains and shackles, he had broken the chains and shattered the shackles. Now there was no one with the strength to subdue him.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  5,
                                        "text":  "Night and day in the tombs and in the mountains he kept crying out and cutting himself with stones.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  6,
                                        "text":  "When the man saw Jesus from a distance, he ran and fell on his knees before Him.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  7,
                                        "text":  "And he shouted in a loud voice, âWhat do You want with me, Jesus, Son of the Most High God? I beg You before God not to torture me!â",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  8,
                                        "text":  "For Jesus had already declared, âCome out of this man, you unclean spirit!â",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  9,
                                        "text":  "âWhat is your name?â Jesus asked.\nâMy name is Legion,â he replied, âfor we are many.â",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  10,
                                        "text":  "And he begged Jesus repeatedly not to send them out of that region.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  11,
                                        "text":  "There on the nearby hillside a large herd of pigs was feeding.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  12,
                                        "text":  "So the demons begged Jesus, âSend us to the pigs, so that we may enter them.â",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  13,
                                        "text":  "He gave them permission, and the unclean spirits came out and went into the pigs, and the herd of about two thousand rushed down the steep bank into the sea and drowned in the water.",
                                        "footnotes":  [
                                                          {
                                                              "noteId":  26,
                                                              "offset":  182,
                                                              "text":  "Literally and were drowned in the sea",
                                                              "caller":  "+"
                                                          }
                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  14,
                                        "text":  "Those tending the pigs ran off and reported this in the town and countryside, and the people went out to see what had happened.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  15,
                                        "text":  "When they came to Jesus, they saw the man who had been possessed by the legion of demons sitting there, clothed and in his right mind; and they were afraid.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  16,
                                        "text":  "Those who had seen it described what had happened to the demon-possessed man and also to the pigs.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  17,
                                        "text":  "And the people began to beg Jesus to leave their region.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  18,
                                        "text":  "As He was getting into the boat, the man who had been possessed by the demons begged to go with Him.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  19,
                                        "text":  "But Jesus would not allow him. âGo home to your own people,â He said, âand tell them how much the Lord has done for you, and what mercy He has shown you.â",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  20,
                                        "text":  "So the man went away and began to proclaim throughout the Decapolis how much Jesus had done for him. And everyone was amazed.",
                                        "footnotes":  [
                                                          {
                                                              "noteId":  27,
                                                              "offset":  67,
                                                              "text":  "That is, the Ten Cities",
                                                              "caller":  "+"
                                                          }
                                                      ]
                                    },
                                    {
                                        "type":  "heading",
                                        "text":  "The Healing Touch of Jesus"
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  21,
                                        "text":  "When Jesus had again crossed by boat to the other side, a large crowd gathered around Him beside the sea.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  22,
                                        "text":  "A synagogue leader named Jairus arrived, and seeing Jesus, he fell at His feet",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  23,
                                        "text":  "and pleaded with Him urgently, âMy little daughter is near death. Please come and place Your hands on her, so that she will be healed and live.â",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  24,
                                        "text":  "So Jesus went with him, and a large crowd followed and pressed around Him.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  25,
                                        "text":  "And a woman was there who had suffered from bleeding for twelve years.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  26,
                                        "text":  "She had borne much agony under the care of many physicians and had spent all she had, but to no avail. Instead, her condition had only grown worse.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  27,
                                        "text":  "When the woman heard about Jesus, she came up through the crowd behind Him and touched His cloak.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  28,
                                        "text":  "For she kept saying, âIf only I touch His garments, I will be healed.â",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  29,
                                        "text":  "Immediately her bleeding stopped, and she sensed in her body that she was healed of her affliction.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  30,
                                        "text":  "At once Jesus was aware that power had gone out from Him. Turning to the crowd, He asked, âWho touched My garments?â",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  31,
                                        "text":  "His disciples answered, âYou can see the crowd pressing in on You, and yet You ask, âWho touched Me?ââ",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  32,
                                        "text":  "But He kept looking around to see who had done this.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  33,
                                        "text":  "Then the woman, knowing what had happened to her, came and fell down before Him trembling in fear, and she told Him the whole truth.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  34,
                                        "text":  "âDaughter,â said Jesus, âyour faith has healed you. Go in peace and be free of your affliction.â",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  35,
                                        "text":  "While He was still speaking, messengers from the house of Jairus arrived and said, âYour daughter is dead; why bother the Teacher anymore?â",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  36,
                                        "text":  "But Jesus overheard their conversation and said to Jairus, âDo not be afraid; just believe.â",
                                        "footnotes":  [
                                                          {
                                                              "noteId":  28,
                                                              "offset":  19,
                                                              "text":  "Or ignored",
                                                              "caller":  "+"
                                                          }
                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  37,
                                        "text":  "And He did not allow anyone to accompany Him except Peter, James, and John the brother of James.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "line_break"
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  38,
                                        "text":  "When they arrived at the house of the synagogue leader, Jesus saw the commotion and the people weeping and wailing loudly.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  39,
                                        "text":  "He went inside and asked, âWhy all this commotion and weeping? The child is not dead, but asleep.â",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  40,
                                        "text":  "And they laughed at Him.\nAfter He had put them all outside, He took the childâs father and mother and His own companions, and went in to see the child.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  41,
                                        "text":  "Taking her by the hand, Jesus said, âTalitha koum!â which means, âLittle girl, I say to you, get up!â",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  42,
                                        "text":  "Immediately the girl got up and began to walk around (she was twelve years old). And at once they were utterly astounded.",
                                        "footnotes":  [

                                                      ]
                                    },
                                    {
                                        "type":  "verse",
                                        "number":  43,
                                        "text":  "Then Jesus gave strict orders that no one should know about this, and He told them to give her something to eat.",
                                        "footnotes":  [

                                                      ]
                                    }
                                ],
                    "footnotes":  [

                                  ]
                },
    "fullChapterApiLink":  "/api/BSB/MRK/5.json"
}
