# Seeded with the Zork I fixture: library, opening, and the story's own
# save/restore round trip through the slot picker.
wait-for Interactive fiction
wait-for zork1
clean
shot parser-library
tap zork1
wait-for West of House
clean
shot parser-opening
tap Keyboard
type save
tap Run
wait-for Ok.
clean
shot parser-story-save
type restore
tap Run
wait-for Story checkpoint
clean
shot parser-restore-picker
tap Story checkpoint
# At large text scales the room description spans the page turn; the last
# line is what lands on the final page at every scale.
wait-for small mailbox
clean
shot parser-restored
