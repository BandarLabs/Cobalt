# Seeded path: run `kobo vault push DIR --sim` before starting the simulator.
# Unseeded store still shows the empty splash; this script requires notes.
wait 500
expect Vault
expect notes
tap Browse
expect Welcome
expect Alpha
clean
shot browse
tap Welcome
expect home note of the fixture
clean
shot note
# Wiki links read as their words, never as [[brackets]], and the note's
# heading is set as a heading above them.
expect Alpha
expect-missing [[
tap Back
wait-for Welcome
tap Back
wait-for notes
expect-missing kobo vault init
