# sweep: --bare --seed-root examples/gutenbird/fixtures/offline
# Two books on the device, one of them open when the application was last
# left, and no connection:
#
#   python3 scripts/check-apps-sim.py gutenbird --bare \
#     --seed-root examples/gutenbird/fixtures/offline \
#     --route examples/gutenbird/drive-offline.kobo
#
# Starting goes straight back into the open book, with no catalog asked first.
scenario offline
wait-for A Lamp for the Ledger
wait-for-id reader-forward
clean
shot gutenbird-offline-resumed
# Back from the book is the list of books on the device, which needs no
# connection. A book kept before titles were recorded is still listed.
tap Back
wait-for On this device
expect A Lamp for the Ledger
expect A. Keeper
expect Book downloaded earlier
clean
shot gutenbird-offline-device
tap Back
wait-for Catalogs
expect Ready offline: 2 books
# A catalog that cannot be reached says so once, and points at the books that
# need no catalog rather than ending there.
tap Standard Ebooks
wait-for Books on this device
expect-missing Permission needed
clean
shot gutenbird-offline-catalog
tap Books on this device
wait-for-id device-1
tap-id device-1
wait-for An Older Book
# The reading bar stays hidden until the top of the page is touched, and it
# shortens a long title with an ellipsis at large text sizes.
expect-missing Book downloaded
tap-at 536,12
wait-idle
expect Book downloaded
# Back from the book is the device list again. In the first book a
# bookmark is kept and listed under Notes.
tap-id 4294967295
wait-for On this device
tap-id device-0
wait-for-id reader-forward
tap-id reader-controls
wait-for Page 1 of
tap-id reader-bookmark
wait-for Bookmarked
tap-id reader-highlights
wait-for Bookmarks
expect Remove bookmark
clean
shot gutenbird-offline-notes
# Back to the book is the page, ready to read, with the panel put away.
tap Back to the book
wait-for-id reader-forward
wait-idle
expect-missing Page 1 of
clean
shot gutenbird-offline-back-to-book
# Read it to the end.
tap-id reader-forward
tap-id reader-forward
tap-id reader-forward
tap-id reader-forward
tap-id reader-forward
tap-id reader-forward
tap-id reader-forward
wait-for This is the end
clean
shot gutenbird-offline-end
# Removing a book asks first; Keep it keeps it, Remove takes it off.
# Back leaves the book, and the first Back puts the message away.
tap-id 4294967295
wait-for On this device
tap-id device-menu-0
wait-for Remove from this device
tap Remove from this device
wait-for from this device?
expect Your place in it is kept
clean
shot gutenbird-offline-remove-ask
tap Keep it
wait-for-id device-1
expect A Lamp for the Ledger
tap-id device-menu-0
tap Remove from this device
wait-for from this device?
tap-id remove-confirm
wait-for On this device
expect-missing A Lamp for the Ledger
expect Book downloaded earlier
clean
shot gutenbird-offline-removed
# The removal outlives the app.
restart
wait-idle
tap-id catalogs
wait-for Ready offline: 1 book
