# The empty list offers Add; typed tasks land on the list one after another
# without the keyboard going away between them.
wait-for Nothing to do
expect Write down the first thing to do.
clean
shot todo-empty
tap Add a task
wait-for New item
type water the fern
expect water the fern
clean
shot todo-new
tap Add
wait-for Added
expect New item
type buy milk
tap Add
expect Todo: 2 left
# Back on the reader's keyboard puts it away after a run of adds.
tap Back
wait-for water the fern
expect buy milk
expect-missing Nothing to do
clean
shot todo-list
# Ticking several items and finishing them together.
tap Select
wait-for Select items
expect None selected
tap water the fern
wait-for 1 selected
tap buy milk
wait-for 2 selected
clean
shot todo-selecting
tap Finish
wait-for Todo: all done
# Deleting several at once, and the undo that follows it.
tap Select
wait-for Select items
tap Select all
wait-for 2 selected
expect Select none
tap Delete
wait-for Undo delete
clean
shot todo-deleted
tap Undo delete
wait-for water the fern
expect buy milk
expect Todo: all done
