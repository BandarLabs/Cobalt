# The simulator's catalog has every app installed except Sudoku.
# First run: the filters, the labelled browser link, and updates first.
# At the largest text size the tabs give up their counts so their names
# stay whole, and the open tab's heading carries its count.
wait-for App Store
expect Link browser
expect Available
expect Updates
shot store-catalog
tap-id filter-available
wait-for Available to install
expect Sudoku
# A failed install stays on the app, and its error banner offers to try
# again.
scenario offline
tap Sudoku
wait-for Not installed
tap Install
wait-for Check Wi-Fi and try again.
expect Try again
shot store-install-failed
# Trying again with Wi-Fi back installs it and stays on the app, with Open.
scenario normal
tap Try again
wait-for Sudoku is installed.
expect Open
expect Uninstall
expect-missing Not installed
shot store-installed
# Uninstall asks first, and Cancel keeps the app.
tap Uninstall
wait-for Uninstall Sudoku?
expect Its saved data stays on this reader
shot store-uninstall-confirm
tap Cancel
expect-missing Uninstall Sudoku?
expect Open
tap Uninstall
wait-for Uninstall Sudoku?
tap-id confirm-remove
wait-for Sudoku is uninstalled.
shot store-uninstalled
# Install on the row opens the app's page, so its permissions are read
# before anything is installed; the page's own Install installs it.
tap Install
wait-for Permissions
expect Not installed
shot store-install-from-row
tap-id install-sudoku
wait-for Sudoku is installed.
expect Open
tap-id 4294967295
wait-for Every app in the catalog is installed.
shot store-installed-from-row
tap-id filter-updates
wait-for Every installed app is up to date.
