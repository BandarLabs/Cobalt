.DS_Store
/.kobo/
/target/
# The daemon's tests write their scratch devices here, one directory per run,
# and they are not build output the root pattern already covers.
/crates/kobod/target/
/.pass

# Credentials. `kobo secret` reads keys off this machine and writes them
# straight to the reader; nothing it touches belongs in a commit. These
# patterns are here so a key that is copied into the tree for a moment cannot
# be added by accident.
secrets/
*.pem
*.key
.env
.env.*
.openai
.anthropic
.credentials

# The running development log. Useful while building, not part of what ships.
BUILD_IN_PUBLIC.md
