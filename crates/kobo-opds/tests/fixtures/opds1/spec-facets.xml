<?xml version="1.0" encoding="UTF-8"?>
<!--
  Facets, sort relations and a thread count, as OPDS 1.2 section 4 defines
  them. Neither of the vendored conformance catalogs exercises facets, so this
  one is written from the specification's own examples rather than captured
  from a live service.
-->
<feed xmlns="http://www.w3.org/2005/Atom"
      xmlns:opds="http://opds-spec.org/2010/catalog"
      xmlns:thr="http://purl.org/syndication/thread/1.0"
      xmlns:dcterms="http://purl.org/dc/terms/"
      xmlns:opensearch="http://a9.com/-/spec/opensearch/1.1/">
  <id>https://example.org/facets.xml</id>
  <title>Faceted Acquisition Feed</title>
  <updated>2024-01-01T00:00:00Z</updated>

  <link rel="self" type="application/atom+xml;profile=opds-catalog;kind=acquisition" href="facets.xml"/>
  <link rel="start" type="application/atom+xml;profile=opds-catalog;kind=navigation" href="root.xml"/>

  <link rel="http://opds-spec.org/facet"
        href="/feed/facets/en"
        title="English"
        opds:facetGroup="Language"
        thr:count="600"/>
  <link rel="http://opds-spec.org/facet"
        href="/feed/facets/fr"
        title="French"
        opds:facetGroup="Language"
        opds:activeFacet="true"
        thr:count="200"/>
  <link rel="http://opds-spec.org/facet"
        href="/feed/facets/available"
        title="Available now"
        opds:facetGroup="Availability"
        thr:count="42"/>

  <link rel="http://opds-spec.org/sort/popular"
        type="application/atom+xml;profile=opds-catalog;kind=acquisition"
        href="/feed/popular"
        title="Popular"/>
  <link rel="http://opds-spec.org/sort/new"
        type="application/atom+xml;profile=opds-catalog;kind=acquisition"
        href="/feed/new"
        title="New"/>
  <link rel="http://opds-spec.org/crawlable"
        type="application/atom+xml;profile=opds-catalog;kind=acquisition"
        href="/feed/crawlable"
        title="Everything"/>

  <opensearch:totalResults>800</opensearch:totalResults>
  <opensearch:itemsPerPage>20</opensearch:itemsPerPage>
  <opensearch:startIndex>1</opensearch:startIndex>

  <entry>
    <title>A Book With Every Acquisition Kind</title>
    <id>urn:example:1</id>
    <updated>2024-01-01T00:00:00Z</updated>
    <author><name>An Author</name></author>
    <dcterms:language>en</dcterms:language>
    <dcterms:issued>1902</dcterms:issued>
    <dcterms:extent>1.4 MB</dcterms:extent>
    <rights>Public domain</rights>
    <summary type="text">The short form, which a client should prefer only when there is no description.</summary>
    <content type="html">&lt;p&gt;The long form, which OPDS 1.2 section 5.1.3 says wins when both are present.&lt;/p&gt;</content>
    <category scheme="http://purl.org/dc/terms/LCSH" term="FBFIC000000" label="Fiction"/>

    <link rel="http://opds-spec.org/image" type="image/jpeg" href="cover.jpg"/>
    <link rel="http://opds-spec.org/image/thumbnail" type="image/jpeg" href="thumb.jpg"/>

    <link rel="http://opds-spec.org/acquisition/open-access" type="application/epub+zip" href="free.epub" length="1468006"/>
    <link rel="http://opds-spec.org/acquisition/sample" type="application/epub+zip" href="sample.epub"/>
    <link rel="http://opds-spec.org/acquisition/buy" type="text/html" href="buy">
      <opds:price currencycode="USD">4.99</opds:price>
      <opds:indirectAcquisition type="application/epub+zip"/>
    </link>
    <link rel="http://opds-spec.org/acquisition/borrow" type="text/html" href="borrow">
      <opds:indirectAcquisition type="application/atom+xml;type=entry;profile=opds-catalog">
        <opds:indirectAcquisition type="application/epub+zip"/>
      </opds:indirectAcquisition>
    </link>
    <link rel="http://opds-spec.org/acquisition/subscribe" type="text/html" href="subscribe"/>
  </entry>

  <entry>
    <title>A Book Whose Thumbnail Is Inline</title>
    <id>urn:example:2</id>
    <updated>2024-01-01T00:00:00Z</updated>
    <author><name>Another Author</name></author>
    <link rel="http://opds-spec.org/image/thumbnail"
          type="image/gif"
          href="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"/>
    <link rel="http://opds-spec.org/acquisition" type="application/epub+zip" href="second.epub"/>
  </entry>

  <entry>
    <title>A Book That Is Not Available</title>
    <id>urn:example:3</id>
    <updated>2024-01-01T00:00:00Z</updated>
    <link rel="http://opds-spec.org/acquisition/borrow" type="text/html" href="unavailable">
      <opds:unavailable/>
      <opds:indirectAcquisition type="application/epub+zip"/>
    </link>
  </entry>
</feed>
