<?xml version="1.0" encoding="UTF-8"?>
<!--
  One catalog, written twice. This is the OPDS 1.2 half; `parity-2.0.json` is
  the same catalog in OPDS 2.0, field for field.

  The two exist so a test can assert that the application draws the same
  screens from either, because the version a catalog speaks is a fact about the
  wire and must never reach the panel. Anything added to one must be added to
  the other, or the test is no longer testing what it claims to.
-->
<feed xmlns="http://www.w3.org/2005/Atom"
      xmlns:opds="http://opds-spec.org/2010/catalog"
      xmlns:dcterms="http://purl.org/dc/terms/"
      xmlns:opensearch="http://a9.com/-/spec/opensearch/1.1/">
  <id>https://parity.example/catalog</id>
  <title>A Small Library</title>
  <subtitle>Two books and a way to look for more</subtitle>
  <updated>2024-06-01T00:00:00Z</updated>

  <link rel="self"
        type="application/atom+xml;profile=opds-catalog;kind=acquisition"
        href="https://parity.example/catalog"/>
  <link rel="start"
        type="application/atom+xml;profile=opds-catalog;kind=navigation"
        href="https://parity.example/catalog"/>
  <link rel="next"
        type="application/atom+xml;profile=opds-catalog;kind=acquisition"
        href="https://parity.example/catalog?page=2"/>

  <opensearch:totalResults>2</opensearch:totalResults>
  <opensearch:itemsPerPage>2</opensearch:itemsPerPage>

  <entry>
